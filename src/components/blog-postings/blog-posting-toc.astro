---
import type { MarkdownHeading } from 'astro'
import Eyebrow from '@components/ui/eyebrow.astro'

type Props = {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const sections = headings.filter((heading) => heading.depth === 2)
---

{
  sections.length >= 3 && (
    <nav
      aria-labelledby="toc-label"
      class="border-l-2 border-neutral-200 pl-5 dark:border-neutral-800"
    >
      <Eyebrow id="toc-label">On this page</Eyebrow>
      <ol class="mt-3 flex flex-col gap-2">
        {sections.map((section) => (
          <li>
            <a
              href={`#${section.slug}`}
              class="hover:text-accent-700 focus-visible:text-accent-700 dark:hover:text-accent-300 dark:focus-visible:text-accent-300 text-sm leading-snug text-neutral-700 underline-offset-[0.2em] transition-colors hover:underline focus-visible:underline focus-visible:outline-none sm:text-base dark:text-neutral-300"
            >
              {section.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
