---
import type { CollectionEntry } from 'astro:content'
import DefaultBlogPostingCard from './blog-posting-card/default-blog-posting-card.astro'
import CompactBlogPostingCard from './blog-posting-card/compact-blog-posting-card.astro'

type Props = {
  blogPosting: CollectionEntry<'blog-postings'>
  keywords?: CollectionEntry<'defined-terms'>[] | undefined
  variant?: 'default' | 'compact'
  headingLevel?: 2 | 3
}

const { blogPosting, keywords = [], variant = 'default', headingLevel = 3 } = Astro.props
---

{
  variant === 'compact' ? (
    <CompactBlogPostingCard
      blogPosting={blogPosting}
      keywords={keywords}
      headingLevel={headingLevel}
    />
  ) : (
    <DefaultBlogPostingCard
      blogPosting={blogPosting}
      keywords={keywords}
      headingLevel={headingLevel}
    />
  )
}
