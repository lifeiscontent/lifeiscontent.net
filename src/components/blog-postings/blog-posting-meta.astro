---
import type { CollectionEntry } from 'astro:content'
import readingTime from 'reading-time'
import Stack from '@components/layouts/stack.astro'
import Text from '@components/ui/text.astro'
import { formatLongDate } from '@lib/dates'

type Props = {
  blogPosting: CollectionEntry<'blog-postings'>
  // inline: date and reading time on one wrapping row. stacked: one per line on phones.
  layout?: 'inline' | 'stacked'
}

const { blogPosting, layout = 'inline' } = Astro.props
const { datePublished } = blogPosting.data

const layoutProps =
  layout === 'inline'
    ? ({ direction: 'row', gap: 'sm', wrap: true, align: 'center' } as const)
    : ({ direction: 'column', directionAtSm: 'row', gap: 'xs', align: 'start' } as const)
---

<Stack as="div" gapX="md" {...layoutProps}>
  <Text as="time" size="xs" tone="subtle" weight="medium" datetime={datePublished.toISOString()}>
    {formatLongDate(datePublished)}
  </Text>
  <Text as="span" size="xs" tone="subtle">
    {readingTime(blogPosting.body ?? '').text}
  </Text>
</Stack>
