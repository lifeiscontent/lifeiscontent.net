---
import type { CollectionEntry } from 'astro:content'
import Card from '@components/ui/card.astro'
import Stack from '@components/layouts/stack.astro'
import BlogPostingMeta from '../blog-posting-meta.astro'
import BlogPostingTitle from '../blog-posting-title.astro'
import BlogPostingDescription from '../blog-posting-description.astro'
import BlogPostingKeywords from '../blog-posting-keywords.astro'

type Props = {
  blogPosting: CollectionEntry<'blog-postings'>
  keywords: CollectionEntry<'defined-terms'>[]
  headingLevel: 2 | 3
}

const { blogPosting, keywords, headingLevel } = Astro.props
---

<Card gap="md">
  <BlogPostingMeta blogPosting={blogPosting} />
  <Stack direction="column" gap="sm">
    <BlogPostingTitle blogPosting={blogPosting} level={headingLevel} size="lg" />
    <BlogPostingDescription blogPosting={blogPosting} size="base" />
  </Stack>
  {keywords.length > 0 && <BlogPostingKeywords keywords={keywords} />}
</Card>
