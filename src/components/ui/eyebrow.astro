---
import clsx from 'clsx'
import type { HTMLAttributes } from 'astro/types'

type EyebrowAttributes = HTMLAttributes<'p'> & HTMLAttributes<'span'> & HTMLAttributes<'div'>

type Props = Omit<EyebrowAttributes, 'class' | 'style'> & {
  as?: keyof HTMLElementTagNameMap
}

const { as: Component = 'p', ...htmlProps } = Astro.props

const className = clsx(
  'font-mono text-[0.8125rem] leading-snug font-medium tracking-[0.16em] uppercase',
  'text-neutral-600 dark:text-neutral-400'
)
---

<Component class={className} {...htmlProps}>
  <slot />
</Component>
