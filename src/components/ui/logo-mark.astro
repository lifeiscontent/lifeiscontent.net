---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

const LOGO_WIDTH = 80

type Props = {
  src: ImageMetadata
  alt: string
}

const { src, alt } = Astro.props
---

<div class="w-14 sm:w-20">
  <Image
    src={src}
    alt={alt}
    width={LOGO_WIDTH}
    height={LOGO_WIDTH}
    class="h-auto w-full saturate-0 dark:invert"
    loading="eager"
  />
</div>
