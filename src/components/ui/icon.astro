---
import Cue from '@components/ui/cue.astro'

export type IconName =
  | 'calendar'
  | 'clock'
  | 'refresh'
  | 'external'
  | 'github'
  | 'x'
  | 'email'
  | 'rss'

type Props = {
  name: IconName
  tone?: 'default' | 'subtle'
  size?: 'xs' | 'sm' | 'md'
}

const { name, tone = 'default', size = 'sm' } = Astro.props
---

<Cue tone={tone} size={size}>
  {
    name === 'calendar' && (
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5a2.25 2.25 0 0 0 2.25-2.25m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5a2.25 2.25 0 0 1 2.25 2.25v7.5"
        />
      </svg>
    )
  }
  {
    name === 'clock' && (
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
        />
      </svg>
    )
  }
  {
    name === 'refresh' && (
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
        />
      </svg>
    )
  }
  {
    name === 'external' && (
      <svg viewBox="0 0 20 20" fill="currentColor">
        <path d="M12.5 3h4a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-1 0V4.707l-9.146 9.147a.5.5 0 0 1-.708-.708L15.293 4H12.5a.5.5 0 0 1 0-1Z" />
        <path d="M5.5 5H9a.5.5 0 0 1 0 1H6v8.5A1.5 1.5 0 0 0 7.5 16h8a1.5 1.5 0 0 0 1.5-1.5V11a.5.5 0 0 1 1 0v3.5A2.5 2.5 0 0 1 15.5 17h-8A2.5 2.5 0 0 1 5 14.5V5.5a.5.5 0 0 1 .5-.5Z" />
      </svg>
    )
  }
  {
    name === 'github' && (
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.373 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.562 21.8 24 17.303 24 12 24 5.373 18.627 0 12 0Z" />
      </svg>
    )
  }
  {
    name === 'x' && (
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117Z" />
      </svg>
    )
  }
  {
    name === 'email' && (
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M21 4.5H3A1.5 1.5 0 0 0 1.5 6v12A1.5 1.5 0 0 0 3 19.5h18a1.5 1.5 0 0 0 1.5-1.5V6A1.5 1.5 0 0 0 21 4.5Zm-.75 3-8.675 5.206a1.5 1.5 0 0 1-1.15.157c-.195-.053-.38-.133-.55-.239L2.25 7.5V6l9.25 5.562L20.25 6z" />
      </svg>
    )
  }
  {
    name === 'rss' && (
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M5 3.5a1.5 1.5 0 0 0 0 3c6.351 0 11.5 5.149 11.5 11.5a1.5 1.5 0 0 0 3 0C19.5 10.065 13.435 4 5 4a1.5 1.5 0 0 0 0-.5Zm0 5a1.5 1.5 0 0 0 0 3 6.5 6.5 0 0 1 6.5 6.5 1.5 1.5 0 0 0 3 0C14.5 12.268 9.732 7.5 5 7.5Zm.5 6A2.5 2.5 0 1 0 8 16a2.5 2.5 0 0 0-2.5-2.5Z" />
      </svg>
    )
  }
</Cue>
