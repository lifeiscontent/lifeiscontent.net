---
import clsx from 'clsx'
import type { HTMLAttributes } from 'astro/types'

type Props = Omit<HTMLAttributes<'div'>, 'class' | 'style'>
const htmlProps = Astro.props

const className = clsx(
  'relative w-full max-w-4xl overflow-hidden rounded-[32px] border px-6 py-10 sm:px-10 sm:py-12',
  'border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900'
)
---

<div class={className} {...htmlProps}>
  <!-- The same accent hairline as the top of the page -->
  <div
    aria-hidden="true"
    class="via-accent-500 pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent to-transparent"
  >
  </div>
  <slot />
</div>
